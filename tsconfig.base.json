{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  }
}
